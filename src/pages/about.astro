---
/*
|--------------------------------------------------------------------------
| About Page
|--------------------------------------------------------------------------
|
| Professional information is loaded from:
|
|   src/data/profile.ts
|
*/

import BaseLayout from '../layouts/BaseLayout.astro';

import {
  professionalSummary,
  professionalStrengths,
  careerJourney,
  careerGoals,
} from '../data/profile';
---

<BaseLayout
  title="Professional Profile"
  description="Professional profile, engineering background and career direction of James Roberts."
>
  <!-- ======================================================= -->
  <!-- HERO                                                    -->
  <!-- ======================================================= -->

  <section class="about-hero">
    <div class="container about-hero-grid">
      <div>
        <p class="eyebrow">Professional Profile</p>

        <h1>
          Infrastructure experience with a
          <span>modern engineering focus.</span>
        </h1>

        <p class="hero-summary">
          {professionalSummary.introduction}
        </p>

        <div class="button-row">

        <a
          class="button button-primary"
          href="/files/James_Roberts_CV.pdf"
          target="_blank"
        >
          📄 Download 2 Page CV
        </a>

        <a
          class="button button-secondary"
          href="/files/James_Roberts_Profile.pdf"
          target="_blank"
        >
          📋 One Page Profile
        </a>

        <a
          class="button button-secondary"
          href="https://www.linkedin.com/in/james-roberts-007752393/"
          target="_blank"
          rel="noopener noreferrer"
        >
          💼 LinkedIn
        </a>

        <a
          class="button button-secondary"
          href="https://github.com/jrwroberts1976"
          target="_blank"
          rel="noopener noreferrer"
        >
          💻 GitHub
        </a>

          <a class="button button-primary" href="/projects">
            Explore projects
          </a>

          <a class="button button-secondary" href="/leadership">
            Technical leadership
          </a>
        </div>
      </div>

      <aside class="profile-panel">
        <p class="eyebrow">Current Direction</p>

        <h2>Platform, cloud and infrastructure engineering</h2>

        <p>
          {professionalSummary.currentFocus}
        </p>

        <ul>
          <li>Linux and UNIX infrastructure</li>
          <li>Docker and Kubernetes</li>
          <li>AWS and Microsoft Azure</li>
          <li>Terraform and automation</li>
          <li>Monitoring and observability</li>
          <li>Security engineering</li>
        </ul>
      </aside>
    </div>
  </section>

  <!-- ======================================================= -->
  <!-- PROFESSIONAL APPROACH                                   -->
  <!-- ======================================================= -->

  <section class="section section-soft">
    <div class="container content-grid">
      <div class="section-heading">
        <p class="eyebrow">How I Work</p>
        <h2>Engineering beyond implementation.</h2>
      </div>

      <div class="prose">
        <p>
          {professionalSummary.headline}
        </p>

        <p>
          {professionalSummary.workingStyle}
        </p>

        <p>
          My background in support and operations means I naturally consider
          resilience, supportability, troubleshooting, monitoring and service
          continuity when designing technical solutions.
        </p>
      </div>
    </div>
  </section>

  <!-- ======================================================= -->
  <!-- PROFESSIONAL STRENGTHS                                  -->
  <!-- ======================================================= -->

  <section class="section">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">Core Strengths</p>

        <h2>Experience across technology and operations.</h2>

        <p>
          My experience combines deep operational knowledge with practical
          development across modern infrastructure tooling.
        </p>
      </div>

      <div class="strengths-grid">
        {
          professionalStrengths.map((strength, index) => (
            <article class="strength-card">
              <span>{String(index + 1).padStart(2, '0')}</span>
              <h3>{strength.title}</h3>
              <p>{strength.description}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ======================================================= -->
  <!-- CAREER JOURNEY                                          -->
  <!-- ======================================================= -->

  <section class="section section-soft">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">Career Journey</p>

        <h2>Building on a strong infrastructure foundation.</h2>

        <p>
          My development into cloud and platform engineering builds on
          extensive experience supporting real operational environments.
        </p>
      </div>

      <div class="journey">
        {
          careerJourney.map((stage, index) => (
            <article class="journey-item">
              <div class="journey-marker">
                <span>{String(index + 1).padStart(2, '0')}</span>
              </div>

              <div>
                <p class="journey-period">{stage.period}</p>
                <h3>{stage.title}</h3>
                <p>{stage.description}</p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ======================================================= -->
  <!-- CAREER GOALS                                            -->
  <!-- ======================================================= -->

  <section class="section">
    <div class="container goals-grid">
      <div class="section-heading">
        <p class="eyebrow">Career Direction</p>

        <h2>Combining experience with continual development.</h2>
      </div>

      <div class="goals-list">
        {
          careerGoals.map((goal, index) => (
            <article>
              <span>{String(index + 1).padStart(2, '0')}</span>
              <p>{goal}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ======================================================= -->
  <!-- FINAL ACTION                                            -->
  <!-- ======================================================= -->

  <section class="section section-soft">
    <div class="container final-panel">
      <div>
        <p class="eyebrow">Practical Evidence</p>

        <h2>Explore the engineering work behind the profile.</h2>

        <p>
          The projects, architecture and live dashboards provide practical
          evidence of the technologies and approaches described here.
        </p>
      </div>

      <div class="button-row">
        <a class="button button-primary" href="/projects">
          Engineering projects
        </a>

        <a class="button button-secondary" href="/lab">
          Engineering Lab
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .about-hero {
    padding: 7rem 0 5rem;
  }

  .about-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(300px, 0.65fr);
    align-items: center;
    gap: 4rem;
  }

  h1 {
    max-width: 900px;
    margin: 0 0 1.5rem;
    font-size: clamp(3rem, 7vw, 5.8rem);
    letter-spacing: -0.055em;
    line-height: 0.98;
  }

  h1 span {
    display: block;
    color: var(--primary);
  }

  .hero-summary {
    max-width: 760px;
    color: var(--text-muted);
    font-size: 1.2rem;
  }

  .profile-panel {
    padding: 1.75rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background:
      radial-gradient(
        circle at top right,
        rgba(93, 184, 255, 0.14),
        transparent 16rem
      ),
      var(--surface);
    box-shadow: var(--shadow);
  }

  .profile-panel h2 {
    margin-top: 0;
  }

  .profile-panel p,
  .profile-panel li {
    color: var(--text-muted);
  }

  .profile-panel ul {
    display: grid;
    gap: 0.55rem;
    padding-left: 1.2rem;
  }

  .content-grid,
  .goals-grid {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: 5rem;
  }

  .strengths-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .strength-card {
    padding: 1.5rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
  }

  .strength-card > span {
    color: var(--primary);
    font-size: 1.8rem;
    font-weight: 850;
  }

  .strength-card h3 {
    margin: 0.8rem 0 0.4rem;
  }

  .strength-card p {
    color: var(--text-muted);
  }

  .journey {
    display: grid;
    max-width: 900px;
    gap: 0;
  }

  .journey-item {
    display: grid;
    grid-template-columns: 70px 1fr;
    gap: 1.4rem;
    min-height: 160px;
  }

  .journey-marker {
    position: relative;
    display: flex;
    justify-content: center;
  }

  .journey-marker::after {
    position: absolute;
    top: 46px;
    bottom: 0;
    width: 1px;
    background: var(--border);
    content: "";
  }

  .journey-item:last-child .journey-marker::after {
    display: none;
  }

  .journey-marker span {
    display: grid;
    width: 44px;
    height: 44px;
    place-items: center;
    border: 1px solid rgba(93, 184, 255, 0.45);
    border-radius: 50%;
    background: var(--surface);
    color: var(--primary);
    font-weight: 850;
  }

  .journey-period {
    margin: 0;
    color: var(--primary);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .journey-item h3 {
    margin: 0.25rem 0;
  }

  .journey-item p:last-child {
    color: var(--text-muted);
  }

  .goals-list {
    display: grid;
    gap: 1rem;
  }

  .goals-list article {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1rem;
    padding: 1.2rem;
    border: 1px solid var(--border);
    border-radius: 14px;
    background: var(--surface);
  }

  .goals-list span {
    color: var(--primary);
    font-weight: 850;
  }

  .goals-list p {
    margin: 0;
    color: var(--text-muted);
  }

  .final-panel {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 3rem;
    padding: 2.5rem;
    border: 1px solid rgba(93, 184, 255, 0.35);
    border-radius: var(--radius);
    background: var(--surface);
  }

  .final-panel h2 {
    margin: 0;
  }

  .final-panel p:last-child {
    color: var(--text-muted);
  }

  @media (max-width: 950px) {
    .about-hero-grid,
    .content-grid,
    .goals-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .strengths-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 700px) {
    .strengths-grid {
      grid-template-columns: 1fr;
    }

    .journey-item {
      grid-template-columns: 52px 1fr;
    }

    .final-panel {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
