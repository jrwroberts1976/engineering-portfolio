---
/*
===============================================================================
Page: Delivery and Leadership

Purpose:
Presents practical project-delivery and technical-leadership experience through
real examples of service transition, infrastructure change, monitoring
improvement, mentoring and stakeholder coordination.
===============================================================================
*/

import BaseLayout from '../layouts/BaseLayout.astro';

const deliveryExamples = [
  {
    category: 'Service Transition',
    title: 'Offshore Infrastructure Patching Transition',
    summary:
      'Led the transfer of routine infrastructure patching to an offshore service provider while maintaining security, consistency and service continuity.',
    challenge:
      'The organisation needed a more repeatable and cost-effective patching model without increasing operational risk or disrupting business services.',
    role:
      'I provided technical and process leadership across planning, documentation, knowledge transfer, supplier coordination and operational handover.',
    actions: [
      'Defined the technical scope and operating requirements.',
      'Documented repeatable patching procedures and escalation routes.',
      'Coordinated knowledge transfer with the offshore delivery team.',
      'Addressed security, language, cultural and time-zone challenges.',
      'Supported governance, implementation planning and service readiness.',
      'Monitored the transition and helped resolve early delivery issues.',
    ],
    risks: [
      'Incomplete knowledge transfer',
      'Security and access concerns',
      'Service disruption',
      'Different working practices',
      'Dependency on individual technical knowledge',
    ],
    outcomes: [
      'Created a consistent and repeatable patching process.',
      'Reduced reliance on individual team members.',
      'Improved operational sustainability.',
      'Supported a more cost-effective delivery model.',
      'Minimised disruption during the transition.',
    ],
  },
  {
    category: 'Infrastructure Change',
    title: 'Shared IT Environment Separation',
    summary:
      'Worked with internal teams and a third-party provider to separate a shared IT environment so two organisations could operate independently.',
    challenge:
      'The shared solution contained technical and operational dependencies that had to be identified and separated without affecting service continuity.',
    role:
      'I helped coordinate the technical workstreams, suppliers, dependencies and stakeholder communication throughout the change.',
    actions: [
      'Helped define the scope, objectives and expected outcomes.',
      'Identified infrastructure, application and operational dependencies.',
      'Coordinated internal technical teams and external suppliers.',
      'Supported implementation planning and change-control activities.',
      'Communicated technical decisions and delivery impacts.',
      'Helped manage internal resistance and competing priorities.',
    ],
    risks: [
      'Unidentified technical dependencies',
      'Loss of service during separation',
      'Supplier coordination failure',
      'Conflicting stakeholder priorities',
      'Incomplete support handover',
    ],
    outcomes: [
      'Supported the successful separation of the environment.',
      'Enabled both organisations to operate independently.',
      'Maintained focus on service continuity.',
      'Improved clarity of technical ownership.',
      'Strengthened cross-team and supplier collaboration.',
    ],
  },
  {
    category: 'Technical Delivery',
    title: 'DrayTek SIM Upgrade Programme',
    summary:
      'Provided technical leadership and escalation support during a structured upgrade programme affecting deployed DrayTek network equipment.',
    challenge:
      'The upgrade involved equipment in service and therefore carried potential customer, connectivity and operational risks.',
    role:
      'I acted as the technical lead, supporting planning, issue management, escalations and communication between support and delivery teams.',
    actions: [
      'Provided technical input during implementation planning.',
      'Helped identify risks before rollout activity.',
      'Supported engineers with complex upgrade issues.',
      'Provided a clear technical escalation route.',
      'Maintained focus on customer impact and service continuity.',
      'Helped resolve technical exceptions during delivery.',
    ],
    risks: [
      'Loss of remote connectivity',
      'Customer service interruption',
      'Inconsistent implementation',
      'Unresolved technical exceptions',
    ],
    outcomes: [
      'Improved confidence during the rollout.',
      'Reduced technical and operational risk.',
      'Provided stronger escalation support.',
      'Helped maintain customer service continuity.',
    ],
  },
  {
    category: 'Service Improvement',
    title: 'Grafana Monitoring Proof of Concept',
    summary:
      'Developed and presented a Grafana proof of concept to improve visibility of service behaviour, infrastructure health and operational trends.',
    challenge:
      'Support teams had limited central visibility and often relied on manual checks or isolated technical data.',
    role:
      'I identified the opportunity, built the proof of concept and communicated the operational value of improved monitoring.',
    actions: [
      'Identified useful infrastructure and service metrics.',
      'Created dashboards focused on operational questions.',
      'Demonstrated the value of centralised visibility.',
      'Translated technical information into accessible views.',
      'Gathered feedback from technical users.',
      'Used the proof of concept to support continual improvement.',
    ],
    risks: [
      'Collecting data without operational value',
      'Poor user adoption',
      'Alert noise',
      'Incorrect interpretation of technical metrics',
    ],
    outcomes: [
      'Improved understanding of service health.',
      'Created a foundation for proactive support.',
      'Demonstrated practical observability benefits.',
      'Improved communication of technical conditions.',
    ],
  },
];

const deliverySkills = [
  'Scope and requirements definition',
  'Stakeholder engagement',
  'Supplier coordination',
  'Risk and dependency management',
  'Implementation planning',
  'Technical leadership',
  'Governance and change control',
  'Knowledge transfer',
  'Issue and escalation management',
  'Operational handover',
  'Service continuity',
  'Continuous improvement',
];

const leadershipPrinciples = [
  {
    title: 'Clarity',
    description:
      'Break complex technical work into clear objectives, responsibilities, dependencies and next steps.',
  },
  {
    title: 'Ownership',
    description:
      'Ensure decisions, actions and risks have accountable owners throughout delivery.',
  },
  {
    title: 'Communication',
    description:
      'Keep technical teams, suppliers and stakeholders aligned through clear and timely updates.',
  },
  {
    title: 'Risk awareness',
    description:
      'Identify technical and operational risks early enough to reduce their impact.',
  },
  {
    title: 'Supportability',
    description:
      'Treat operational handover, documentation and maintainability as part of delivery.',
  },
  {
    title: 'Continuous improvement',
    description:
      'Use lessons from implementation and support to improve future delivery.',
  },
];

const mentoringOutcomes = [
  'Encouraged engineers to take ownership of more complex investigations.',
  'Explained the reasoning behind technical decisions rather than only providing instructions.',
  'Provided structured support during escalations.',
  'Improved confidence among first- and second-line colleagues.',
  'Helped bridge the gap between development and support teams.',
  'Reduced dependency on individual subject-matter experts.',
];
---

<BaseLayout
  title="Delivery and Leadership"
  description="Project delivery, technical leadership, stakeholder management, supplier coordination and operational change experience demonstrated through real infrastructure initiatives."
>
  <!-- ======================================================= -->
  <!-- HERO                                                    -->
  <!-- ======================================================= -->

  <section class="leadership-hero">
    <div class="container hero-grid">
      <div>
        <p class="eyebrow">Delivery and Leadership</p>

        <h1>
          Delivering technical change through
          <span>planning, leadership and operational focus.</span>
        </h1>

        <p class="hero-summary">
          My background combines hands-on infrastructure experience with
          responsibilities closely aligned to project management, including
          scope definition, stakeholder engagement, supplier coordination,
          risk management, implementation and operational handover.
        </p>

        <div class="button-row">
          <a class="button button-primary" href="#case-studies">
            View Delivery Case Studies
          </a>

          <a class="button button-secondary" href="/journey">
            Engineering Journey
          </a>
        </div>
      </div>

      <aside class="delivery-overview">
        <p class="eyebrow">Delivery Approach</p>

        <ul>
          <li>Understand the business and technical objective.</li>
          <li>Define scope, dependencies and responsibilities.</li>
          <li>Identify risks before implementation.</li>
          <li>Coordinate teams, suppliers and stakeholders.</li>
          <li>Communicate progress, issues and decisions clearly.</li>
          <li>Ensure a supportable operational handover.</li>
        </ul>
      </aside>
    </div>
  </section>

  <!-- ======================================================= -->
  <!-- DELIVERY CAPABILITY                                     -->
  <!-- ======================================================= -->

  <section class="section section-soft">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">Project Delivery Capability</p>

        <h2>Technical depth supported by structured delivery.</h2>

        <p>
          These capabilities have been developed through practical
          infrastructure change, service transition and operational
          improvement.
        </p>
      </div>

      <div class="skills-grid">
        {
          deliverySkills.map((skill, index) => (
            <article>
              <span>{String(index + 1).padStart(2, '0')}</span>
              <strong>{skill}</strong>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ======================================================= -->
  <!-- LEADERSHIP PRINCIPLES                                   -->
  <!-- ======================================================= -->

  <section class="section">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">Leadership Principles</p>

        <h2>Creating clarity, confidence and momentum.</h2>

        <p>
          My approach is collaborative and practical, with equal attention to
          delivery, people and operational outcomes.
        </p>
      </div>

      <div class="principles-grid">
        {
          leadershipPrinciples.map((principle, index) => (
            <article>
              <span>{String(index + 1).padStart(2, '0')}</span>
              <h3>{principle.title}</h3>
              <p>{principle.description}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ======================================================= -->
  <!-- CASE STUDIES                                            -->
  <!-- ======================================================= -->

  <section id="case-studies" class="section section-soft">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">Delivery Case Studies</p>

        <h2>Real examples of leading and coordinating change.</h2>

        <p>
          Each example demonstrates planning, stakeholder communication,
          technical judgement, risk management and operational responsibility.
        </p>
      </div>

      <div class="case-studies">
        {
          deliveryExamples.map((example, index) => (
            <article class="case-study">
              <header>
                <span class="case-number">
                  {String(index + 1).padStart(2, '0')}
                </span>

                <div>
                  <p class="case-category">{example.category}</p>
                  <h3>{example.title}</h3>
                  <p class="case-summary">{example.summary}</p>
                </div>
              </header>

              <div class="case-introduction">
                <div>
                  <h4>Challenge</h4>
                  <p>{example.challenge}</p>
                </div>

                <div>
                  <h4>My role</h4>
                  <p>{example.role}</p>
                </div>
              </div>

              <div class="case-details">
                <div>
                  <h4>Delivery actions</h4>
                  <ul>
                    {example.actions.map((action) => <li>{action}</li>)}
                  </ul>
                </div>

                <div>
                  <h4>Risks managed</h4>
                  <ul>
                    {example.risks.map((risk) => <li>{risk}</li>)}
                  </ul>
                </div>

                <div>
                  <h4>Outcomes</h4>
                  <ul>
                    {example.outcomes.map((outcome) => <li>{outcome}</li>)}
                  </ul>
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ======================================================= -->
  <!-- MENTORING                                               -->
  <!-- ======================================================= -->

  <section class="section">
    <div class="container mentoring-grid">
      <div class="section-heading">
        <p class="eyebrow">Mentoring and Team Development</p>

        <h2>Helping engineers build confidence and ownership.</h2>

        <p>
          Technical leadership is also about enabling others to solve problems
          and grow their capability.
        </p>
      </div>

      <div class="mentoring-list">
        {
          mentoringOutcomes.map((outcome, index) => (
            <article>
              <span>{String(index + 1).padStart(2, '0')}</span>
              <p>{outcome}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ======================================================= -->
  <!-- MANAGEMENT APPROACH                                     -->
  <!-- ======================================================= -->

  <section class="section section-soft">
    <div class="container approach-grid">
      <div class="section-heading">
        <p class="eyebrow">Management Approach</p>

        <h2>Bridging technical teams and business outcomes.</h2>
      </div>

      <div class="prose">
        <p>
          My project-delivery approach is grounded in understanding both the
          technology and the operational consequences of change.
        </p>

        <p>
          I work to ensure that technical teams understand the objective,
          stakeholders understand the risks and progress, and operational
          teams receive a solution that can be supported after implementation.
        </p>

        <p>
          This enables me to bridge project management, engineering and service
          operations—helping technical initiatives move from planning through
          implementation to successful handover.
        </p>
      </div>
    </div>
  </section>

  <!-- ======================================================= -->
  <!-- FINAL PANEL                                             -->
  <!-- ======================================================= -->

  <section class="section">
    <div class="container final-panel">
      <div>
        <p class="eyebrow">Supporting Evidence</p>

        <h2>Explore the platforms behind the delivery experience.</h2>

        <p>
          The project case studies, architecture and live dashboards
          demonstrate the technical capability supporting my leadership and
          delivery approach.
        </p>
      </div>

      <div class="button-column">
        <a class="button button-primary" href="/projects">
          Engineering Projects
        </a>

        <a class="button button-secondary" href="/lab">
          Engineering Lab
        </a>

        <a class="button button-secondary" href="/about">
          Professional Profile
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .leadership-hero {
    padding: 7rem 0 5rem;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(300px, 0.65fr);
    align-items: center;
    gap: 4rem;
  }

  h1 {
    max-width: 920px;
    margin: 0 0 1.5rem;
    font-size: clamp(3rem, 7vw, 5.8rem);
    letter-spacing: -0.055em;
    line-height: 0.98;
  }

  h1 span {
    display: block;
    color: var(--primary);
  }

  .hero-summary {
    max-width: 780px;
    color: var(--text-muted);
    font-size: 1.2rem;
  }

  .delivery-overview {
    padding: 1.75rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: var(--shadow);
  }

  .delivery-overview ul {
    display: grid;
    gap: 0.8rem;
    padding-left: 1.2rem;
    color: var(--text-muted);
  }

  .skills-grid,
  .principles-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .skills-grid article,
  .principles-grid article {
    padding: 1.25rem;
    border: 1px solid var(--border);
    border-radius: 14px;
    background: var(--surface);
  }

  .skills-grid article {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: 0.8rem;
  }

  .skills-grid span,
  .principles-grid span {
    color: var(--primary);
    font-weight: 850;
  }

  .principles-grid span {
    font-size: 1.7rem;
  }

  .principles-grid h3 {
    margin: 0.7rem 0 0.35rem;
  }

  .principles-grid p {
    color: var(--text-muted);
  }

  .case-studies {
    display: grid;
    gap: 1.5rem;
  }

  .case-study {
    padding: 2rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background:
      radial-gradient(
        circle at top right,
        rgba(93, 184, 255, 0.1),
        transparent 18rem
      ),
      var(--surface);
  }

  .case-study header {
    display: flex;
    align-items: flex-start;
    gap: 1.2rem;
    padding-bottom: 1.4rem;
    border-bottom: 1px solid var(--border);
  }

  .case-number {
    color: var(--primary);
    font-size: 2rem;
    font-weight: 850;
  }

  .case-category {
    margin: 0;
    color: var(--primary);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .case-study h3 {
    margin: 0.25rem 0 0;
    font-size: 1.65rem;
  }

  .case-summary {
    margin-bottom: 0;
    color: var(--text-muted);
  }

  .case-introduction {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem;
    padding: 1.5rem 0;
  }

  .case-details {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem;
  }

  .case-study h4 {
    margin: 0 0 0.6rem;
  }

  .case-study p,
  .case-study li {
    color: var(--text-muted);
  }

  .case-study ul {
    display: grid;
    gap: 0.55rem;
    padding-left: 1.2rem;
  }

  .mentoring-grid,
  .approach-grid {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: 5rem;
  }

  .mentoring-list {
    display: grid;
    gap: 0.8rem;
  }

  .mentoring-list article {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.8rem;
    padding: 1rem;
    border: 1px solid var(--border);
    border-radius: 13px;
    background: var(--surface);
  }

  .mentoring-list span {
    color: var(--primary);
    font-weight: 850;
  }

  .mentoring-list p {
    margin: 0;
    color: var(--text-muted);
  }

  .final-panel {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 4rem;
    padding: 2.5rem;
    border: 1px solid rgba(93, 184, 255, 0.35);
    border-radius: var(--radius);
    background: var(--surface);
  }

  .button-column {
    display: grid;
    min-width: 230px;
    gap: 0.75rem;
  }

  @media (max-width: 950px) {
    .hero-grid,
    .mentoring-grid,
    .approach-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .skills-grid,
    .principles-grid,
    .case-details {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 700px) {
    .skills-grid,
    .principles-grid,
    .case-introduction,
    .case-details {
      grid-template-columns: 1fr;
    }

    .case-study header {
      flex-direction: column;
    }

    .final-panel {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .button-column {
      width: 100%;
    }
  }
</style>
