---
/*
===============================================================================
Page: Technical Leadership and Project Delivery

Purpose:
Demonstrates practical experience in planning, stakeholder coordination,
supplier management, risk control, implementation and operational handover.
===============================================================================
*/

import BaseLayout from '../layouts/BaseLayout.astro';

const deliveryExamples = [
  {
    category: 'Service Transition',
    title: 'Offshore Infrastructure Patching Transition',
    challenge:
      'Routine infrastructure patching needed to be transferred to an offshore service provider while maintaining security, service continuity and operational quality.',
    role:
      'I provided technical and process leadership across planning, knowledge transfer, documentation and operational handover.',
    actions: [
      'Defined the technical and operational requirements.',
      'Documented repeatable patching procedures.',
      'Coordinated knowledge transfer with the offshore team.',
      'Managed security, language, cultural and time-zone challenges.',
      'Supported governance and implementation planning.',
      'Monitored the transition to ensure service quality was maintained.',
    ],
    risks: [
      'Security and access concerns',
      'Incomplete knowledge transfer',
      'Service disruption',
      'Different working practices',
      'Reliance on individual knowledge',
    ],
    outcomes: [
      'Created a consistent and repeatable patching process.',
      'Reduced reliance on individual team members.',
      'Improved operational sustainability.',
      'Supported cost-effective service delivery.',
      'Minimised disruption to business operations.',
    ],
  },
  {
    category: 'Infrastructure Separation',
    title: 'Shared IT Environment Separation',
    challenge:
      'A shared company IT solution needed to be separated so two organisations could operate independently.',
    role:
      'I worked with internal stakeholders and a third-party provider to coordinate the technical separation and manage operational dependencies.',
    actions: [
      'Helped define the technical scope and expected outcomes.',
      'Identified infrastructure and application dependencies.',
      'Coordinated technical workstreams and suppliers.',
      'Supported implementation planning and change control.',
      'Communicated technical decisions to affected stakeholders.',
      'Helped manage internal resistance and operational concerns.',
    ],
    risks: [
      'Loss of service during separation',
      'Unidentified dependencies',
      'Conflicting stakeholder priorities',
      'Supplier coordination failures',
      'Incomplete operational handover',
    ],
    outcomes: [
      'Supported the successful separation of the shared environment.',
      'Enabled both organisations to operate independently.',
      'Maintained focus on service continuity throughout delivery.',
      'Improved clarity around technical responsibilities.',
      'Strengthened collaboration across supplier and internal teams.',
    ],
  },
  {
    category: 'Technical Delivery',
    title: 'DrayTek SIM Upgrade Programme',
    challenge:
      'A structured upgrade programme was required for deployed DrayTek network equipment, with potential customer and service impact.',
    role:
      'I acted as a technical lead, supporting implementation planning, complex escalations and coordination between support and delivery teams.',
    actions: [
      'Provided technical guidance during planning.',
      'Supported engineers with complex upgrade issues.',
      'Helped identify risks before implementation.',
      'Worked across support and delivery responsibilities.',
      'Maintained focus on customer and service impact.',
      'Supported issue resolution during rollout activity.',
    ],
    risks: [
      'Loss of remote connectivity',
      'Customer service disruption',
      'Inconsistent implementation',
      'Unresolved technical exceptions',
    ],
    outcomes: [
      'Improved confidence during the upgrade programme.',
      'Provided a clear escalation route for technical issues.',
      'Reduced operational risk during implementation.',
      'Helped maintain continuity of customer services.',
    ],
  },
  {
    category: 'Service Improvement',
    title: 'Grafana Monitoring Proof of Concept',
    challenge:
      'Support teams had limited central visibility of service behaviour, infrastructure health and emerging operational trends.',
    role:
      'I identified the opportunity, developed the Grafana proof of concept and communicated how improved monitoring could support operational decisions.',
    actions: [
      'Identified useful service and infrastructure metrics.',
      'Created Grafana dashboards and monitoring views.',
      'Demonstrated the value of centralised visibility.',
      'Translated technical data into accessible operational information.',
      'Gathered feedback from technical users.',
      'Used the proof of concept to support continual improvement.',
    ],
    risks: [
      'Monitoring data without clear operational value',
      'Poor adoption by support teams',
      'Incorrect interpretation of technical metrics',
      'Alert noise',
    ],
    outcomes: [
      'Improved understanding of service health.',
      'Created a foundation for more proactive support.',
      'Demonstrated practical monitoring and observability benefits.',
      'Supported better communication of technical conditions.',
    ],
  },
];

const deliverySkills = [
  'Scope and requirements',
  'Stakeholder engagement',
  'Third-party supplier coordination',
  'Risk and dependency management',
  'Implementation planning',
  'Technical leadership',
  'Governance and change control',
  'Knowledge transfer',
  'Operational handover',
  'Service continuity',
  'Issue and escalation management',
  'Continuous improvement',
];
---

<BaseLayout
  title="Technical Leadership and Project Delivery"
  description="Technical leadership, stakeholder management and project-delivery experience demonstrated through infrastructure change, service transition and operational improvement."
>
  <!-- ======================================================= -->
  <!-- HERO                                                    -->
  <!-- ======================================================= -->

  <section class="leadership-hero">
    <div class="container hero-grid">
      <div>
        <p class="eyebrow">Technical Leadership and Project Delivery</p>

        <h1>
          Delivering technical change through
          <span>planning, coordination and operational focus.</span>
        </h1>

        <p class="hero-summary">
          My background combines hands-on infrastructure experience with
          responsibilities closely aligned to project management, including
          planning, stakeholder engagement, supplier coordination, risk
          management, implementation and operational handover.
        </p>

        <div class="button-row">
          <a class="button button-primary" href="#case-studies">
            View Delivery Examples
          </a>

          <a class="button button-secondary" href="/journey">
            Engineering Journey
          </a>
        </div>
      </div>

      <aside class="delivery-overview">
        <p class="eyebrow">Delivery Approach</p>

        <ul>
          <li>Understand the business and technical objective.</li>
          <li>Define scope, dependencies and responsibilities.</li>
          <li>Identify risks before implementation.</li>
          <li>Coordinate teams, suppliers and stakeholders.</li>
          <li>Communicate clearly throughout delivery.</li>
          <li>Ensure supportable operational handover.</li>
        </ul>
      </aside>
    </div>
  </section>

  <!-- ======================================================= -->
  <!-- DELIVERY SKILLS                                         -->
  <!-- ======================================================= -->

  <section class="section section-soft">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">Project Delivery Capability</p>

        <h2>Technical depth supported by structured delivery.</h2>

        <p>
          These responsibilities have been developed through practical
          infrastructure change rather than theory alone.
        </p>
      </div>

      <div class="skills-grid">
        {
          deliverySkills.map((skill, index) => (
            <article>
              <span>{String(index + 1).padStart(2, '0')}</span>
              <strong>{skill}</strong>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ======================================================= -->
  <!-- DELIVERY CASE STUDIES                                   -->
  <!-- ======================================================= -->

  <section id="case-studies" class="section">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">Delivery Case Studies</p>

        <h2>Examples of leading and coordinating technical change.</h2>

        <p>
          Each example demonstrates a combination of technical understanding,
          planning, stakeholder communication and operational responsibility.
        </p>
      </div>

      <div class="case-studies">
        {
          deliveryExamples.map((example, index) => (
            <article class="case-study">
              <header>
                <span class="case-number">
                  {String(index + 1).padStart(2, '0')}
                </span>

                <div>
                  <p class="case-category">{example.category}</p>
                  <h3>{example.title}</h3>
                </div>
              </header>

              <div class="case-introduction">
                <div>
                  <h4>Challenge</h4>
                  <p>{example.challenge}</p>
                </div>

                <div>
                  <h4>My role</h4>
                  <p>{example.role}</p>
                </div>
              </div>

              <div class="case-details">
                <div>
                  <h4>Delivery actions</h4>
                  <ul>
                    {example.actions.map((action) => <li>{action}</li>)}
                  </ul>
                </div>

                <div>
                  <h4>Risks managed</h4>
                  <ul>
                    {example.risks.map((risk) => <li>{risk}</li>)}
                  </ul>
                </div>

                <div>
                  <h4>Outcomes</h4>
                  <ul>
                    {example.outcomes.map((outcome) => <li>{outcome}</li>)}
                  </ul>
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ======================================================= -->
  <!-- MANAGEMENT APPROACH                                     -->
  <!-- ======================================================= -->

  <section class="section section-soft">
    <div class="container approach-grid">
      <div class="section-heading">
        <p class="eyebrow">Management Approach</p>

        <h2>Bridging technical teams and business outcomes.</h2>
      </div>

      <div class="prose">
        <p>
          My project-delivery approach is grounded in understanding both the
          technology and the operational consequences of change.
        </p>

        <p>
          I work to ensure that technical teams understand the objective,
          stakeholders understand the risks and progress, and operational
          teams receive a solution that can be supported after implementation.
        </p>

        <p>
          This allows me to bridge project management, engineering and service
          operations—helping technical initiatives move from planning through
          implementation to successful handover.
        </p>
      </div>
    </div>
  </section>

  <!-- ======================================================= -->
  <!-- FINAL ACTION                                            -->
  <!-- ======================================================= -->

  <section class="section">
    <div class="container final-panel">
      <div>
        <p class="eyebrow">Supporting Evidence</p>

        <h2>Explore the engineering platforms behind the delivery experience.</h2>

        <p>
          The projects, architecture and live dashboards demonstrate the
          technical capability supporting my leadership and delivery approach.
        </p>
      </div>

      <div class="button-row">
        <a class="button button-primary" href="/projects">
          Engineering Projects
        </a>

        <a class="button button-secondary" href="/lab">
          Engineering Lab
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .leadership-hero {
    padding: 7rem 0 5rem;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(300px, 0.65fr);
    align-items: center;
    gap: 4rem;
  }

  h1 {
    max-width: 920px;
    margin: 0 0 1.5rem;
    font-size: clamp(3rem, 7vw, 5.8rem);
    letter-spacing: -0.055em;
    line-height: 0.98;
  }

  h1 span {
    display: block;
    color: var(--primary);
  }

  .hero-summary {
    max-width: 780px;
    color: var(--text-muted);
    font-size: 1.2rem;
  }

  .delivery-overview {
    padding: 1.75rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: var(--shadow);
  }

  .delivery-overview ul {
    display: grid;
    gap: 0.8rem;
    padding-left: 1.2rem;
    color: var(--text-muted);
  }

  .skills-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .skills-grid article {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: 0.8rem;
    padding: 1rem;
    border: 1px solid var(--border);
    border-radius: 13px;
    background: var(--surface);
  }

  .skills-grid span {
    color: var(--primary);
    font-weight: 850;
  }

  .case-studies {
    display: grid;
    gap: 1.5rem;
  }

  .case-study {
    padding: 2rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background:
      radial-gradient(
        circle at top right,
        rgba(93, 184, 255, 0.1),
        transparent 18rem
      ),
      var(--surface);
  }

  .case-study header {
    display: flex;
    align-items: flex-start;
    gap: 1.2rem;
    padding-bottom: 1.4rem;
    border-bottom: 1px solid var(--border);
  }

  .case-number {
    color: var(--primary);
    font-size: 2rem;
    font-weight: 850;
  }

  .case-category {
    margin: 0;
    color: var(--primary);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .case-study h3 {
    margin: 0.25rem 0 0;
    font-size: 1.65rem;
  }

  .case-introduction {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem;
    padding: 1.5rem 0;
  }

  .case-details {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem;
  }

  .case-study h4 {
    margin: 0 0 0.6rem;
  }

  .case-study p,
  .case-study li {
    color: var(--text-muted);
  }

  .case-study ul {
    display: grid;
    gap: 0.55rem;
    padding-left: 1.2rem;
  }

  .approach-grid {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: 5rem;
  }

  .final-panel {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 3rem;
    padding: 2.5rem;
    border: 1px solid rgba(93, 184, 255, 0.35);
    border-radius: var(--radius);
    background: var(--surface);
  }

  .final-panel h2 {
    margin: 0;
  }

  .final-panel p:last-child {
    color: var(--text-muted);
  }

  @media (max-width: 950px) {
    .hero-grid,
    .approach-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .skills-grid,
    .case-details {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 700px) {
    .skills-grid,
    .case-introduction,
    .case-details {
      grid-template-columns: 1fr;
    }

    .final-panel {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
