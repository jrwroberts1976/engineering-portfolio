---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contact"
  description="Contact James Roberts about infrastructure, platform engineering, cloud, technical delivery and engineering opportunities."
>

<section class="contact-hero">
  <div class="container">
    <p class="eyebrow">Contact</p>

    <h1>
      Interested in my work?
      <span>Let's connect.</span>
    </h1>

    <p class="hero-summary">
      If you would like to discuss infrastructure, platform engineering,
      technical delivery or opportunities to work together, please get in touch.
    </p>
  </div>
</section>


<section class="section section-soft">

  <div class="container">

    <div class="contact-grid">

      <article class="card">

        <p class="eyebrow">GitHub</p>

        <h2>See the work.</h2>

        <p>
          Browse infrastructure projects, automation examples,
          monitoring platforms and engineering documentation.
        </p>

        <a
          class="card-link"
          href="https://github.com/jrwroberts1976"
          target="_blank"
          rel="noopener noreferrer"
        >
          Visit GitHub →
        </a>

      </article>


      <article class="card">

        <p class="eyebrow">Professional Profile</p>

        <h2>See the experience.</h2>

        <p>
          Review my infrastructure background, technical leadership,
          delivery experience and engineering journey.
        </p>

        <a class="card-link" href="/about">
          View profile →
        </a>

      </article>


      <article class="card">

        <p class="eyebrow">Email</p>

        <h2>Start a conversation.</h2>

        <p>
          For enquiries, opportunities or discussions around engineering,
          infrastructure and delivery, contact me directly.
        </p>

        <a
          class="card-link"
          href="mailto:jrwroberts1976@gmail.com"
        >
          Send email →
        </a>

      </article>


      <article class="card">

        <p class="eyebrow">Portfolio</p>

        <h2>Explore the platform.</h2>

        <p>
          Explore case studies covering cloud, Kubernetes, monitoring,
          security operations and resilience engineering.
        </p>

        <a class="card-link" href="/projects">
          View projects →
        </a>

      </article>


    </div>

  </div>

</section>


<section class="section">

  <div class="container">

    <p class="eyebrow">Privacy</p>

    <h2>A simple static contact approach.</h2>

    <div class="prose">

      <p>
        This website does not collect contact form submissions or store
        visitor information.
      </p>

      <p>
        Removing unnecessary processing keeps the platform simpler,
        easier to maintain and reduces operational dependencies.
      </p>

    </div>

  </div>

</section>


</BaseLayout>


<style>

.contact-hero {
  padding: 7rem 0 5rem;
}


h1 {
  max-width: 950px;
  margin: 0 0 1.5rem;
  font-size: clamp(3.2rem, 8vw, 6rem);
  letter-spacing: -.055em;
  line-height: .98;
}


h1 span {
  display: block;
  color: var(--primary);
}


.hero-summary {
  max-width: 760px;
  color: var(--text-muted);
  font-size: 1.1rem;
}


.contact-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 1.25rem;
}


.card {
  display: flex;
  flex-direction: column;
  min-height: 260px;
  padding: 1.6rem;
  border: 1px solid var(--border);
  border-radius: var(--radius);
  background: var(--surface);
}


.card h2 {
  margin: 0 0 1rem;
}


.card p {
  color: var(--text-muted);
}


.card-link {
  margin-top: auto;
  color: var(--primary);
  font-weight: 700;
}


@media (max-width: 850px) {

  .contact-grid {
    grid-template-columns: 1fr;
  }

}

</style>
