---
import BaseLayout from '../../layouts/BaseLayout.astro';
const blocks = [
  {name:'Grafana Alloy',status:'Live; Pi-hole file collection under review',purpose:'Collects and processes host logs, then forwards them to Loki.',where:'Native service across the managed estate; confirmed on dns-01 and dns-02.',why:'One consistent collection pipeline instead of a different log shipper for each application.',inputs:'Systemd journal today; Pi-hole file logs proposed in Step 8.',outputs:'Loki on monitor-01.',verify:'Check systemctl is-active alloy, validate /etc/alloy/config.alloy, and confirm recent labelled streams in Loki.',repeat:'Manage configuration through homelab-platform IaC; test syntax and read permissions before rollout.'},
  {name:'Loki',status:'Live',purpose:'Stores and queries logs collected by Alloy.',where:'monitor-01',why:'Searchable operational and security evidence with host/job labels.',inputs:'Alloy journal, Docker and network pipelines.',outputs:'Grafana log exploration and the 06:00 report.',verify:'Check recent host streams against the expected estate and inspect ingestion freshness.',repeat:'Reconcile Loki configuration through IaC and retain a documented rollback.'},
  {name:'Grafana',status:'Live',purpose:'Visualises logs, metrics and monitoring signals.',where:'monitor-01',why:'A common view of infrastructure health and incident evidence.',inputs:'Prometheus and Loki, plus configured monitoring integrations.',outputs:'Dashboards and operational investigations.',verify:'Check data-source health and confirm panels show live data.',repeat:'Version-control dashboard and data-source provisioning.'},
  {name:'Prometheus',status:'Live',purpose:'Scrapes and queries time-series metrics.',where:'monitor-01',why:'Provides numeric infrastructure and service-health evidence.',inputs:'Node exporter and existing service/probe targets.',outputs:'Grafana, Alertmanager and management-report evidence.',verify:'Inspect target up status and scrape freshness.',repeat:'Keep scrape targets and rules under IaC.'},
  {name:'Alertmanager',status:'Live',purpose:'Groups and routes Prometheus alerts.',where:'monitor-01',why:'Separates actionable incidents from routine monitoring.',inputs:'Prometheus firing alerts.',outputs:'Notifications and the management report.',verify:'Inspect active alerts and notification routing.',repeat:'Manage routes and inhibition rules as code; test before enabling noisy rules.'},
  {name:'Zabbix',status:'Live',purpose:'Agent-based host and service monitoring.',where:'zabbix-01; 15 expected Linux hosts',why:'Independent host telemetry and problem evidence alongside Prometheus.',inputs:'Zabbix Agent 2 active checks.',outputs:'Zabbix frontend and host/problem evidence for the morning report.',verify:'Compare expected hosts with recent numeric measurements; Step 7 verified all 15.',repeat:'Maintain host templates and inventory reconciliation in IaC.'},
  {name:'Pi-hole + Unbound',status:'Live; log integration in progress',purpose:'Filters DNS requests and provides local recursive resolution.',where:'dns-01 and dns-02',why:'Resilient DNS with policy-based blocking.',inputs:'Client DNS queries and managed blocklists.',outputs:'DNS responses, local FTL statistics and query logs.',verify:'Test normal and blocked DNS answers; check pihole api stats/summary locally.',repeat:'Document list policy, configuration, restore and dual-resolver validation.'},
  {name:'Suricata + Zeek',status:'Live',purpose:'Network intrusion detection and network-protocol evidence.',where:'sensor-01',why:'Complementary signature alerts and protocol-level visibility.',inputs:'Mirrored network traffic.',outputs:'Security evidence and management-report sensor summaries.',verify:'Check both services and freshness of schema-v2 sensor evidence.',repeat:'Version-control sensor configuration and verify capture after changes.'},
  {name:'Greenbone',status:'Live',purpose:'Scans the internal estate for known vulnerabilities.',where:'greenbone-01',why:'Evidence-led vulnerability management and accepted-risk tracking.',inputs:'Approved internal scan targets and vulnerability feeds.',outputs:'Findings used by the morning report.',verify:'Check scan completion, feed age and evidence freshness.',repeat:'Keep scan schedules, target lists and accepted-risk decisions documented.'},
  {name:'Snappy',status:'Test tooling installed on dns-01; not a production service',purpose:'Fast, lossless compression used for Loki push-request payloads.',where:'Isolated Python test environment on dns-01.',why:'Lets our synthetic receiver decompress exactly what Alloy sends before checking that no DNS domains or client addresses escaped.',inputs:'Compressed Loki push-request body.',outputs:'Decompressed Protobuf bytes for inspection.',verify:'Import python-snappy in the isolated venv and run the synthetic Alloy privacy regression test.',repeat:'Installed by the opt-in alloy-privacy-test-deps Ansible playbook; no system-wide Python packages.'},
  {name:'Protocol Buffers (Protobuf)',status:'Test tooling installed on dns-01; not a production service',purpose:'Compact binary format for structured messages, including Loki log batches.',where:'Isolated Python test environment on dns-01.',why:'Decodes the structure of synthetic Loki requests so the privacy test can inspect outgoing log lines.',inputs:'Snappy-decompressed Loki push-request bytes.',outputs:'Individual log messages checked against the allowed event names.',verify:'Import google.protobuf in the isolated venv and run the synthetic privacy regression test.',repeat:'Installed through the opt-in Ansible test role alongside python-snappy.'},
  {name:'Ansible + Git',status:'Live',purpose:'Repeatably deploys and validates infrastructure configuration.',where:'admin-01; homelab-platform repository',why:'Reviewed, testable changes with a documented source of truth.',inputs:'IaC inventory, playbooks and roles.',outputs:'Consistent configuration and verification evidence.',verify:'Run syntax checks, SSH preflight, check mode where safe and post-change validation.',repeat:'Record installation, version pinning, upgrade, rollback and recovery for every tool.'}
];
---
<BaseLayout title="Homelab Building Blocks" description="What each homelab tool does, why it was selected, how the components fit together and how deployments are made repeatable.">
  <section class="section"><div class="container">
    <p class="eyebrow">Engineering Lab · Living documentation</p>
    <h1>Building Blocks</h1>
    <p class="lead">What we use, what each tool does, why it is here and how we can deploy and verify it again. Live services are distinguished from work still in progress. The private <code>homelab-platform</code> current-state architecture and inventory remain the deployment authority.</p>
    <div class="pipeline"><strong>Example: how our logging works</strong><p>Host and application logs → <a href="#grafana-alloy">Grafana Alloy</a> (collect and process) → <a href="#loki">Loki</a> (store and query) → <a href="#grafana">Grafana</a> (visualise) → management report (summarise verified evidence).</p><p><strong>Step 8:</strong> Pi-hole query-log collection is proposed, not yet deployed. Logs can contain client addresses and domain names, so privacy and access controls must be verified before forwarding them.</p></div>
    <p>New to these terms? See <a href="/terms-and-references/#snappy">Snappy</a> and <a href="/terms-and-references/#protobuf">Protobuf</a> in Terms and References. These are test dependencies, not extra production log collectors.</p>
    <div class="cards">{blocks.map(block => <article class="block" id={block.name.toLowerCase().replace(/[^a-z0-9]+/g,'-').replace(/-$/,'')}><span class="status">{block.status}</span><h2>{block.name}</h2><p class="purpose">{block.purpose}</p><dl><dt>Where it runs</dt><dd>{block.where}</dd><dt>Why we use it</dt><dd>{block.why}</dd><dt>Input</dt><dd>{block.inputs}</dd><dt>Output / integration</dt><dd>{block.outputs}</dd><dt>How to verify</dt><dd>{block.verify}</dd><dt>Repeatable deployment</dt><dd>{block.repeat}</dd></dl></article>)}</div>
    <section class="pipeline"><h2>Our repeatability standard</h2><p>Each block needs an authoritative inventory entry, an IaC installation or configuration path, version and dependency records, an idempotent deployment method, health and integration tests, monitoring, backup or state-export needs, an upgrade and rollback procedure, and a recovery runbook. Missing proof is marked <strong>not yet verified</strong>, never assumed complete.</p><p>Operational details and private configuration belong in the homelab-platform repository, not on this public page. No passwords, tokens, internal log contents or client browsing history are published.</p></section>
  </div></section>
</BaseLayout>
<style>
h1{font-size:clamp(3rem,7vw,5.5rem);letter-spacing:-.05em;margin:.3rem 0 1rem}.lead{max-width:900px;color:var(--text-muted);font-size:1.18rem}.pipeline{padding:1.5rem;border:1px solid var(--border);border-radius:var(--radius);background:var(--surface);margin:2rem 0}.pipeline p{color:var(--text-muted)}.pipeline a{color:var(--primary)}.cards{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1.2rem}.block{padding:1.5rem;border:1px solid var(--border);border-radius:var(--radius);background:var(--surface);scroll-margin-top:120px}.block h2{margin:.6rem 0}.purpose{font-size:1.08rem}.status{color:var(--primary);font-size:.8rem;font-weight:750}dl{display:grid;grid-template-columns:135px 1fr;gap:.6rem 1rem}dt{font-weight:700}dd{margin:0;color:var(--text-muted)}@media(max-width:850px){.cards{grid-template-columns:1fr}}@media(max-width:520px){dl{grid-template-columns:1fr}dt{margin-top:.5rem}}
</style>