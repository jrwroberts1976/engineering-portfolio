---
/*
|--------------------------------------------------------------------------
| Platform Architecture
|--------------------------------------------------------------------------
|
| Architecture is generated from the platform data source of truth.
*/

import BaseLayout from '../../layouts/BaseLayout.astro';
import ArchitectureNode from '../../components/ArchitectureNode.astro';
import { getPlatformNodesByLayer } from '../../data/platform';

const architectureLayers = [
  { id: 'edge', number: '01', title: 'Edge and Internet', description: 'Public traffic enters through Cloudflare before being routed into the self-hosted environment.' },
  { id: 'access', number: '02', title: 'Access and Identity', description: 'Reverse proxying and authentication control how externally published services are reached.' },
  { id: 'platform', number: '03', title: 'Engineering Platforms', description: 'Docker, Kubernetes and AWS provide the execution environments for applications and engineering workloads.' },
  { id: 'services', number: '04', title: 'Applications and Workloads', description: 'Public applications and specialist workloads run on the underlying engineering platforms.' },
  { id: 'observability', number: '05', title: 'Observability', description: 'Metrics, logs, dashboards and alerts provide operational visibility across the environment.' },
  { id: 'security', number: '06', title: 'Security Enforcement', description: 'Behavioural detection and firewall controls identify and block malicious activity.' },
] as const;

const primaryFlow = [
  { number: '01', title: 'Internet', detail: 'Public traffic' },
  { number: '02', title: 'Cloudflare', detail: 'DNS, TLS and edge protection' },
  { number: '03', title: 'Nginx Proxy Manager', detail: 'Reverse proxy' },
  { number: '04', title: 'Identity', detail: 'Authelia and access policy' },
  { number: '05', title: 'Platforms', detail: 'Docker, Kubernetes and AWS' },
  { number: '06', title: 'Workloads', detail: 'Applications and services' },
];
---

<BaseLayout
  title="Platform Architecture"
  description="Architecture of the James Roberts engineering platform, including edge protection, access, platforms, applications, observability and security."
>
  <section class="architecture-hero">
    <div class="container hero-grid">
      <div>
        <p class="eyebrow">Engineering Platform</p>
        <h1>A connected platform, not a collection of isolated tools.</h1>
        <p class="hero-copy">
          A layered view of the engineering environment, showing how public traffic,
          access controls, execution platforms, workloads, observability and security fit together.
        </p>
      </div>

      <div class="hero-summary">
        <div><strong>06</strong><span>Architecture layers</span></div>
        <div><strong>13</strong><span>Platform components</span></div>
        <div><strong>04</strong><span>Engineering principles</span></div>
      </div>
    </div>
  </section>

  <section class="section architecture-overview">
    <div class="container">
      <div class="section-heading compact-heading">
        <p class="eyebrow">Architecture Overview</p>
        <h2>Follow the request path</h2>
        <p>Public traffic moves from the edge through controlled access into the engineering platforms and hosted workloads.</p>
      </div>

      <div class="request-flow" aria-label="Primary platform request flow">
        {primaryFlow.map((item, index) => (
          <>
            <a class="request-node" href={index === 0 ? '#layer-edge' : index === 1 ? '#layer-edge' : index === 2 || index === 3 ? '#layer-access' : index === 4 ? '#layer-platform' : '#layer-services'}>
              <span>{item.number}</span>
              <strong>{item.title}</strong>
              <small>{item.detail}</small>
            </a>
            {index < primaryFlow.length - 1 && <span class="request-arrow" aria-hidden="true">→</span>}
          </>
        ))}
      </div>

      <div class="cross-cutting">
        <a href="#layer-observability" class="cross-card">
          <span>05</span>
          <div><strong>Observability</strong><small>Prometheus · Grafana · Loki</small></div>
        </a>
        <a href="#layer-security" class="cross-card">
          <span>06</span>
          <div><strong>Security</strong><small>CrowdSec · Linux Firewall</small></div>
        </a>
      </div>
    </div>
  </section>

  <section class="section layers-section">
    <div class="container">
      <div class="section-heading compact-heading">
        <p class="eyebrow">Platform Map</p>
        <h2>Architecture layers</h2>
        <p>Each layer groups related capabilities while retaining direct links to projects and live operational dashboards.</p>
      </div>

      <div class="layers-list">
        {architectureLayers.map((layer, index) => {
          const nodes = getPlatformNodesByLayer(layer.id);

          return (
            <section id={`layer-${layer.id}`} class:list={['architecture-layer', { 'layer-soft': index % 2 !== 0 }]}>
              <div class="layer-meta">
                <span class="layer-number">{layer.number}</span>
                <div>
                  <p class="eyebrow">Architecture Layer</p>
                  <h2>{layer.title}</h2>
                  <p>{layer.description}</p>
                </div>
              </div>

              <div class="layer-components">
                {nodes.map((node) => <ArchitectureNode node={node} />)}
              </div>
            </section>
          );
        })}
      </div>
    </div>
  </section>

  <section class="section principles-section">
    <div class="container">
      <div class="section-heading compact-heading">
        <p class="eyebrow">Design Principles</p>
        <h2>How the platform is engineered</h2>
      </div>

      <div class="principles-grid">
        <article class="principle-card"><span>01</span><h3>Layered access</h3><p>Public exposure is separated from internal workloads through Cloudflare, reverse proxying and identity controls.</p></article>
        <article class="principle-card"><span>02</span><h3>Observable by default</h3><p>Infrastructure and applications are connected to central metrics, logging, dashboards and operational alerts.</p></article>
        <article class="principle-card"><span>03</span><h3>Automated protection</h3><p>CrowdSec detections are translated into Linux firewall actions without requiring manual intervention.</p></article>
        <article class="principle-card"><span>04</span><h3>Documented and repeatable</h3><p>Git repositories, Docker Compose, Terraform and documented procedures make the environment reproducible and supportable.</p></article>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .architecture-hero { padding: clamp(4rem, 8vw, 7rem) 0 4rem; }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 1.6fr) minmax(260px, 0.7fr); gap: 4rem; align-items: end; }
  .architecture-hero h1 { max-width: 900px; margin: 0.5rem 0 1.25rem; font-size: clamp(2.8rem, 6vw, 5.4rem); line-height: 0.98; letter-spacing: -0.055em; }
  .hero-copy { max-width: 760px; color: var(--text-muted); font-size: 1.15rem; line-height: 1.7; }
  .hero-summary { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.75rem; }
  .hero-summary div { padding: 1rem; border: 1px solid var(--border); border-radius: 12px; background: var(--surface); }
  .hero-summary strong { display: block; color: var(--primary); font-size: 1.8rem; line-height: 1; }
  .hero-summary span { display: block; margin-top: 0.45rem; color: var(--text-muted); font-size: 0.72rem; line-height: 1.25; }

  .architecture-overview { border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); }
  .compact-heading { max-width: 760px; margin-bottom: 2rem; }
  .compact-heading h2 { margin: 0.15rem 0 0.5rem; font-size: clamp(2rem, 4vw, 3rem); letter-spacing: -0.04em; }
  .compact-heading > p:last-child { margin: 0; color: var(--text-muted); line-height: 1.65; }

  .request-flow { display: flex; align-items: stretch; gap: 0.65rem; overflow-x: auto; padding: 0.5rem 0 0.9rem; scrollbar-width: thin; }
  .request-node { flex: 1 0 145px; min-height: 125px; display: flex; flex-direction: column; justify-content: center; padding: 1rem; border: 1px solid var(--border); border-radius: 14px; background: var(--surface); text-decoration: none; transition: transform 160ms ease, border-color 160ms ease, background 160ms ease; }
  .request-node:hover, .cross-card:hover { transform: translateY(-3px); border-color: rgba(93,184,255,.5); background: var(--surface-hover); }
  .request-node span, .cross-card > span { color: var(--primary); font-size: 0.7rem; font-weight: 850; letter-spacing: .08em; }
  .request-node strong { margin-top: .35rem; font-size: .98rem; }
  .request-node small { margin-top: .35rem; color: var(--text-muted); font-size: .76rem; line-height: 1.35; }
  .request-arrow { align-self: center; flex: 0 0 auto; color: var(--primary); font-size: 1.25rem; }

  .cross-cutting { display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap: 1rem; margin-top: 1rem; }
  .cross-card { display: flex; align-items: center; gap: 1rem; padding: 1rem 1.2rem; border: 1px solid var(--border); border-radius: 13px; background: var(--surface); text-decoration: none; transition: transform 160ms ease, border-color 160ms ease, background 160ms ease; }
  .cross-card strong, .cross-card small { display: block; }
  .cross-card small { margin-top: .25rem; color: var(--text-muted); font-size: .8rem; }

  .layers-section { padding-top: 4rem; }
  .layers-list { border-top: 1px solid var(--border); }
  .architecture-layer { display: grid; grid-template-columns: minmax(250px, 0.8fr) minmax(0, 2fr); gap: clamp(2rem, 5vw, 5rem); padding: 3rem 1rem; border-bottom: 1px solid var(--border); border-radius: 16px; }
  .architecture-layer.layer-soft { background: var(--surface); }
  .layer-meta { display: grid; grid-template-columns: auto minmax(0,1fr); align-items: start; gap: 1.25rem; }
  .layer-number { color: var(--primary); font-size: clamp(2.4rem, 5vw, 4rem); font-weight: 900; line-height: .9; letter-spacing: -.05em; }
  .layer-meta h2 { margin: 0.15rem 0 .55rem; font-size: clamp(1.6rem, 3vw, 2.35rem); letter-spacing: -.035em; }
  .layer-meta > div > p:last-child { margin: 0; color: var(--text-muted); font-size: .92rem; line-height: 1.6; }
  .layer-components { display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap: 1rem; }
  .principles-section { border-top: 1px solid var(--border); }
  .principles-grid { display: grid; grid-template-columns: repeat(4, minmax(0,1fr)); gap: 1rem; }
  .principle-card { padding: 1.4rem; border: 1px solid var(--border); border-radius: 14px; background: var(--surface); }
  .principle-card > span { color: var(--primary); font-size: 1.6rem; font-weight: 850; }
  .principle-card h3 { margin: .65rem 0 .5rem; }
  .principle-card p { margin: 0; color: var(--text-muted); font-size: .88rem; line-height: 1.6; }

  @media (max-width: 1050px) {
    .hero-grid { grid-template-columns: 1fr; gap: 2rem; }
    .principles-grid { grid-template-columns: repeat(2, minmax(0,1fr)); }
  }

  @media (max-width: 800px) {
    .architecture-layer { grid-template-columns: 1fr; gap: 1.75rem; padding: 2.25rem .25rem; }
    .layer-components { grid-template-columns: 1fr; }
  }

  @media (max-width: 600px) {
    .hero-summary, .cross-cutting, .principles-grid { grid-template-columns: 1fr; }
    .architecture-hero { padding-top: 3rem; }
    .request-flow { margin-inline: -1rem; padding-inline: 1rem; }
  }
</style>
