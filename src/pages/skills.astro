---
import BaseLayout from '../layouts/BaseLayout.astro';
const skills=[
{id:'linux',title:'Linux & Systems Administration',tech:'Linux · UNIX · Debian · Red Hat',evidence:'20+ years of infrastructure operations, incident resolution, patching, troubleshooting and service support. Current platform administration provides additional hands-on Linux evidence.',href:'/about'},
{id:'virtualisation',title:'Virtualisation & Infrastructure Platforms',tech:'VMware · vSphere · ESXi · Proxmox VE · LXC · QEMU/KVM · Corosync · QDevice',evidence:'Long-standing professional experience working with VMware virtualised infrastructure, complemented by current hands-on design and operation of a two-node Proxmox VE cluster. Experience covers virtual machine administration, infrastructure troubleshooting and operational support, alongside Proxmox clustering, quorum, Corosync networking, LXC and QEMU/KVM workloads, backup and recovery.',href:'/projects/proxmox-platform'},
{id:'containers',title:'Containers & Platform Operations',tech:'Docker · Docker Compose · Komodo · Kubernetes/K3s',evidence:'Operational Docker workloads with lifecycle management through Komodo. Previous Kubernetes/K3s experience will be refreshed with a new current-platform deployment.',href:'/projects/docker-platform'},
{id:'automation',title:'Automation & Infrastructure as Code',tech:'Ansible · Bash · Git · Terraform · GitHub Actions',evidence:'Professional Linux patch automation progressed from Bash to Ansible; current engineering work uses Git-managed, repeatable and rollback-aware infrastructure change.',href:'/projects/engineering-platform'},
{id:'observability',title:'Monitoring & Observability',tech:'Prometheus · Grafana · Alertmanager · Loki · Alloy · Zabbix · Blackbox',evidence:'Central monitoring, metrics, logging, dashboards, probing and alerting across infrastructure and services, including custom operational metrics.',href:'/projects/monitoring'},
{id:'networking',title:'Networking & Security',tech:'Networking · DNS · VPN · VLANs · Firewalls · Antivirus / Endpoint Security · Greenbone · Suricata · Zeek',evidence:'Experience across network troubleshooting, DNS, VPNs, switching and firewalling, together with antivirus and endpoint security administration. Current hands-on work includes redundant DNS, OpenVPN, vulnerability management with Greenbone, and network security monitoring using Suricata and Zeek.',href:'/projects/engineering-platform'},
{id:'delivery',title:'CI/CD & Technical Delivery',tech:'Jenkins · Gradle · Docker · Trivy · GitHub Actions · ITIL',evidence:'Delivery experience spans controlled infrastructure change, CI/CD labs, security scanning, documentation, operational handover and technical leadership.',href:'/leadership'}
];
---
<BaseLayout title="Technical Skills" description="Technical skills and experience for James Roberts, infrastructure and systems engineer.">
<section class="page-intro"><div class="container section-heading"><p class="eyebrow">Technical Skills</p><h1>Capability, technology and experience.</h1><p>A practical overview of my technical skills and experience across infrastructure, systems, automation, monitoring, networking and security. Each area reflects technologies I have worked with professionally or through hands-on engineering projects.</p></div></section>
<section class="section section-soft"><div class="container skills-grid">{skills.map((s)=><article id={s.id}><p class="eyebrow">{s.tech}</p><h2>{s.title}</h2><p>{s.evidence}</p><a class="card-link" href={s.href}>View related work →</a></article>)}</div></section>
</BaseLayout>
<style>
.page-intro h1{margin:0;font-size:clamp(3rem,7vw,5.5rem);letter-spacing:-.05em;line-height:1}.skills-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1.25rem}.skills-grid article{padding:2rem;border:1px solid var(--border);border-radius:var(--radius);background:var(--surface)}.skills-grid h2{margin:.35rem 0 .8rem;font-size:clamp(1.6rem,3vw,2.2rem)}.skills-grid article>p:not(.eyebrow){color:var(--text-muted)}@media(max-width:750px){.skills-grid{grid-template-columns:1fr}}
</style>