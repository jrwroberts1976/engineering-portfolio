---
/*
|--------------------------------------------------------------------------
| Projects Overview
|--------------------------------------------------------------------------
|
| Project data comes from:
|
|   src/data/projects.ts
|
| Do not add project definitions directly to this page.
|
*/

import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';

import { projects } from '../../data/projects';
---

<BaseLayout
  title="Engineering Projects"
  description="Infrastructure, cloud, container, monitoring and security engineering case studies by James Roberts."
>
  <section class="page-intro">
    <div class="container projects-heading">
      <p class="eyebrow">Engineering Portfolio</p>
      <h1>Projects built to be operated, not just demonstrated.</h1>
      <p>
        These case studies show how I approach architecture, implementation,
        monitoring, security, documentation and ongoing operational support.
      </p>
    </div>
  </section>

  <section class="section section-soft">
    <div class="container">
      <div class="projects-grid">
        {
          projects.map((project) => (
            <ProjectCard
              category={project.category}
              title={project.title}
              description={project.description}
              href={project.href}
              status={project.status}
              technologies={project.technologies}
            />
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .projects-heading {
    max-width: var(--max-width);
    margin-inline: auto;
    padding-inline: 0;
  }

  .projects-heading h1 {
    max-width: 900px;
    margin: 0;
    font-size: clamp(2.8rem, 7vw, 5.5rem);
    line-height: 1.02;
    letter-spacing: -0.04em;
  }

  .projects-heading p:last-child {
    max-width: 760px;
    margin-top: 1.2rem;
    color: var(--text-muted);
    font-size: 1.1rem;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
  }

  @media (max-width: 850px) {
    .projects-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
