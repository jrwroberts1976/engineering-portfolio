---
/*
|--------------------------------------------------------------------------
| Projects Overview
|--------------------------------------------------------------------------
|
| For now the portfolio has one primary project entry point: the Engineering
| Platform. Individual technology case studies will be added back here as
| those technologies are introduced to the current Proxmox platform.
|
*/

import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';

import { getProjectById } from '../../data/projects';

const project = getProjectById('engineering-platform');

if (!project) {
  throw new Error('Engineering Platform project is missing from project data.');
}
---

<BaseLayout
  title="Engineering Projects"
  description="The Engineering Platform behind James Roberts' infrastructure portfolio."
>
  <section class="page-intro">
    <div class="container projects-heading">
      <p class="eyebrow">Engineering Portfolio</p>
      <h1>Projects built to be operated, not just demonstrated.</h1>
      <p>
        The Engineering Platform is the main project for now. Additional
        technology case studies will be added as those technologies are
        introduced to the current Proxmox platform.
      </p>
    </div>
  </section>

  <section class="section section-soft">
    <div class="container">
      <div class="projects-grid">
        <ProjectCard
          category={project.category}
          title={project.title}
          description={project.description}
          href={project.href}
          status={project.status}
          technologies={project.technologies}
        />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .projects-heading {
    max-width: var(--max-width);
    margin-inline: auto;
    padding-inline: 0;
  }

  .projects-heading h1 {
    max-width: 900px;
    margin: 0;
    font-size: clamp(2.8rem, 7vw, 5.5rem);
    line-height: 1.02;
    letter-spacing: -0.04em;
  }

  .projects-heading p:last-child {
    max-width: 760px;
    margin-top: 1.2rem;
    color: var(--text-muted);
    font-size: 1.1rem;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem;
    max-width: 900px;
  }
</style>
