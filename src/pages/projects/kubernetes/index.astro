---
/*
===============================================================================
Page: Kubernetes Homelab

Purpose:
Documents the planning and implementation of a practical K3s platform using
MetalLB, Traefik, containerd and Git-based deployment practices.
===============================================================================
*/

import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getProjectById } from '../../../data/projects';

const project = getProjectById('kubernetes');

if (!project) {
  throw new Error('Kubernetes project data could not be found.');
}

const objectives = [
  {
    title: 'Build practical Kubernetes experience',
    description:
      'Develop skills through operating a functioning cluster rather than using isolated examples.',
  },
  {
    title: 'Create local load balancing',
    description:
      'Provide Kubernetes LoadBalancer services with addresses usable on the home network.',
  },
  {
    title: 'Implement ingress',
    description:
      'Use a consistent ingress layer for routing requests to applications.',
  },
  {
    title: 'Use Git-based deployment',
    description:
      'Store manifests, scripts and documentation in version control.',
  },
  {
    title: 'Document the platform',
    description:
      'Maintain architecture, deployment, operations, security and troubleshooting guidance.',
  },
  {
    title: 'Support future expansion',
    description:
      'Create a foundation for monitoring, GitOps and additional application workloads.',
  },
];

const deliveryPhases = [
  {
    number: '01',
    title: 'Prepare the host',
    description:
      'Validated Debian, system resources, networking, storage, sudo access and swap configuration.',
  },
  {
    number: '02',
    title: 'Install K3s',
    description:
      'Created a single-node control-plane environment using K3s and containerd.',
  },
  {
    number: '03',
    title: 'Validate cluster health',
    description:
      'Confirmed the node was Ready and core Kubernetes services were running.',
  },
  {
    number: '04',
    title: 'Configure MetalLB',
    description:
      'Defined a safe local address pool and assigned a stable LoadBalancer address.',
  },
  {
    number: '05',
    title: 'Use Traefik ingress',
    description:
      'Configured ingress routing for application access through the cluster.',
  },
  {
    number: '06',
    title: 'Deploy the first workload',
    description:
      'Created a namespace, deployment, service and ingress for a practical demonstration application.',
  },
];

const components = [
  {
    category: 'Distribution',
    title: 'K3s',
    description:
      'Provides a lightweight Kubernetes distribution suitable for the ARM64 lab environment.',
  },
  {
    category: 'Runtime',
    title: 'containerd',
    description:
      'Runs and manages container workloads beneath Kubernetes.',
  },
  {
    category: 'Ingress',
    title: 'Traefik',
    description:
      'Routes HTTP requests to services using Kubernetes ingress resources.',
  },
  {
    category: 'Load Balancing',
    title: 'MetalLB',
    description:
      'Provides usable LoadBalancer addresses on the local Layer 2 network.',
  },
  {
    category: 'Storage',
    title: 'NVMe Host Storage',
    description:
      'Provides sufficient local capacity for workloads, images and future persistent data.',
  },
  {
    category: 'Delivery',
    title: 'Git Repository',
    description:
      'Stores scripts, manifests, architecture decisions and operational documentation.',
  },
];

const decisions = [
  {
    title: 'Use K3s',
    decision:
      'Select K3s rather than a heavier multi-component Kubernetes installation.',
    reason:
      'The platform needed to run efficiently on ARM64 hardware while providing genuine Kubernetes capability.',
    benefit:
      'Lower operational overhead with access to standard Kubernetes resources and tooling.',
  },
  {
    title: 'Begin with one node',
    decision:
      'Start with a single control-plane node before expanding to multiple nodes.',
    reason:
      'This allowed focus on Kubernetes concepts, networking and deployment before adding cluster complexity.',
    benefit:
      'Created a manageable learning environment with a clear future expansion path.',
  },
  {
    title: 'Use MetalLB',
    decision:
      'Provide Layer 2 LoadBalancer addresses from a reserved section of the LAN.',
    reason:
      'Local Kubernetes environments do not receive managed cloud load balancers.',
    benefit:
      'Applications can use standard LoadBalancer services with stable network addresses.',
  },
  {
    title: 'Retain Traefik',
    decision:
      'Use the ingress controller provided and supported by K3s.',
    reason:
      'Traefik integrates naturally with K3s and avoids unnecessary replacement during the initial platform stage.',
    benefit:
      'Reduced implementation complexity while retaining standard ingress capability.',
  },
];

const challenges = [
  {
    title: 'LoadBalancer address conflict',
    problem:
      'The initial MetalLB address selected was already in use by another device on the network.',
    response:
      'Scanned the available address range, identified safe addresses and changed the assigned IP.',
    outcome:
      'The Kubernetes service received a stable address without disrupting another device.',
  },
  {
    title: 'Namespace deployment error',
    problem:
      'The first workload resources were applied before the expected namespace existed.',
    response:
      'Created the namespace and reapplied the deployment, service and ingress resources.',
    outcome:
      'The application deployed successfully and the importance of dependency order was reinforced.',
  },
  {
    title: 'Host resource planning',
    problem:
      'The cluster needed sufficient memory, storage and network stability for future workloads.',
    response:
      'Validated the host before installation and documented available capacity.',
    outcome:
      'The cluster runs on a suitable foundation with room for continued development.',
  },
  {
    title: 'Operational documentation',
    problem:
      'A working cluster without clear operating guidance would be difficult to maintain or demonstrate.',
    response:
      'Created architecture, deployment, operations, security, decision and troubleshooting documents.',
    outcome:
      'The project demonstrates both implementation and supportability.',
  },
];

const projectDelivery = [
  {
    title: 'Requirements and readiness',
    description:
      'Validated the operating system, hardware, storage and networking before installation.',
  },
  {
    title: 'Dependency sequencing',
    description:
      'Delivered host preparation, K3s, networking, ingress and workloads in a controlled order.',
  },
  {
    title: 'Risk management',
    description:
      'Checked address availability and avoided introducing conflicts into the existing LAN.',
  },
  {
    title: 'Issue resolution',
    description:
      'Investigated namespace and networking problems using Kubernetes and Linux tooling.',
  },
  {
    title: 'Decision records',
    description:
      'Documented why K3s, Traefik, MetalLB and a single-node starting point were selected.',
  },
  {
    title: 'Future planning',
    description:
      'Structured the repository to support GitOps, monitoring, security and additional nodes.',
  },
];

const outcomes = [
  {
    value: 'Ready',
    title: 'Control-plane node',
    description:
      'A functioning K3s control plane running on dedicated ARM64 hardware.',
  },
  {
    value: 'Stable',
    title: 'LoadBalancer address',
    description:
      'MetalLB provides a fixed address accessible from the local network.',
  },
  {
    value: 'Routed',
    title: 'Ingress traffic',
    description:
      'Traefik routes requests to applications through Kubernetes ingress.',
  },
  {
    value: 'Versioned',
    title: 'Platform definition',
    description:
      'Scripts, manifests and documentation are maintained through Git.',
  },
];

const skills = [
  'Kubernetes',
  'K3s',
  'Linux administration',
  'containerd',
  'MetalLB',
  'Traefik',
  'Kubernetes networking',
  'Deployments and services',
  'Ingress resources',
  'Troubleshooting',
  'Architecture decisions',
  'Project documentation',
];

const platformFacts = [
  {
    label: 'Operating system',
    value: 'Debian 12',
    description:
      'A stable Linux foundation running on dedicated ARM64 hardware.',
  },
  {
    label: 'Kubernetes distribution',
    value: 'K3s',
    description:
      'A lightweight Kubernetes distribution suitable for the available hardware.',
  },
  {
    label: 'Container runtime',
    value: 'containerd',
    description:
      'The runtime responsible for pulling images and running container workloads.',
  },
  {
    label: 'Ingress controller',
    value: 'Traefik',
    description:
      'Routes inbound HTTP traffic to Kubernetes services.',
  },
  {
    label: 'Load balancer',
    value: 'MetalLB',
    description:
      'Provides local Layer 2 LoadBalancer addresses for services.',
  },
  {
    label: 'Storage',
    value: 'NVMe',
    description:
      'Provides local capacity for container images, workloads and future persistent volumes.',
  },
];

const namespaces = [
  {
    name: 'applications',
    purpose:
      'Application workloads intended to run independently from platform services.',
  },
  {
    name: 'argocd',
    purpose:
      'Reserved for GitOps deployment and continuous reconciliation.',
  },
  {
    name: 'monitoring',
    purpose:
      'Monitoring components, dashboards and metrics collection.',
  },
  {
    name: 'logging',
    purpose:
      'Central logging components and log-processing workloads.',
  },
  {
    name: 'metallb-system',
    purpose:
      'MetalLB controllers, speakers and address-pool configuration.',
  },
  {
    name: 'demo',
    purpose:
      'Safe namespace for testing workloads and Kubernetes resources.',
  },
];

const firstWorkload = {
  title: 'Whoami demonstration application',
  description:
    'The first workload was deliberately small so the focus remained on understanding Kubernetes resources and network flow rather than application complexity.',
  resources: [
    'A dedicated demo namespace',
    'A Kubernetes Deployment',
    'A ClusterIP Service',
    'A Traefik Ingress resource',
    'A MetalLB-backed external address',
  ],
  lessons: [
    'Namespaces must exist before namespaced resources are applied.',
    'Services provide stable access even when pods are recreated.',
    'Ingress rules separate external routing from application configuration.',
    'Testing with a simple workload makes networking issues easier to isolate.',
  ],
};

const operationalPractices = [
  {
    title: 'Cluster health checks',
    description:
      'Regularly verify node readiness, pod state, services, ingress resources and system namespaces.',
  },
  {
    title: 'Version-controlled manifests',
    description:
      'Store scripts, YAML resources and documentation in Git so changes remain reviewable and repeatable.',
  },
  {
    title: 'Resource awareness',
    description:
      'Monitor memory, storage and workload requirements before introducing additional applications.',
  },
  {
    title: 'Network planning',
    description:
      'Reserve LoadBalancer addresses carefully to avoid conflicts with existing LAN devices.',
  },
  {
    title: 'Troubleshooting',
    description:
      'Use kubectl, logs, events and Linux network tools to investigate failed deployments and routing problems.',
  },
  {
    title: 'Documentation',
    description:
      'Maintain deployment, operations, security, architecture and troubleshooting guidance alongside the project.',
  },
];

const futureRoadmap = [
  {
    title: 'GitOps with Argo CD',
    description:
      'Use Git as the desired-state source and automatically reconcile approved Kubernetes changes.',
  },
  {
    title: 'Platform monitoring',
    description:
      'Add Kubernetes metrics, node monitoring, pod health and workload dashboards.',
  },
  {
    title: 'Persistent storage',
    description:
      'Introduce a documented storage approach for applications requiring persistent data.',
  },
  {
    title: 'Additional nodes',
    description:
      'Expand from the single-node foundation when greater resilience or workload capacity is needed.',
  },
  {
    title: 'Secrets management',
    description:
      'Improve handling of application credentials and sensitive configuration.',
  },
  {
    title: 'Application migration',
    description:
      'Evaluate suitable Docker workloads for controlled migration into Kubernetes.',
  },
];
---

<BaseLayout
  title={project.title}
  description="A practical K3s platform using MetalLB, Traefik, containerd and Git-based Kubernetes deployment practices."
>
  <section class="project-hero">
    <div class="container hero-grid">
      <div>
        <p class="eyebrow">Container Orchestration Case Study</p>

        <h1>
          Kubernetes
          <span>Homelab Platform</span>
        </h1>

        <p class="hero-summary">
          A practical K3s environment demonstrating Kubernetes deployment,
          ingress, local load balancing, container orchestration and
          operational documentation.
        </p>

        <div class="button-row">
          {
            project.repositoryUrl && (
              <a
                class="button button-primary"
                href={project.repositoryUrl}
                target="_blank"
                rel="noopener noreferrer"
              >
                View GitHub Repository
              </a>
            )
          }

          <a class="button button-secondary" href="/architecture">
            Platform Architecture
          </a>

          <a
            class="button button-secondary"
            href="https://snapshots.raintank.io/dashboard/snapshot/BzrZV2S2NptVcx2h9raIntUKlDqTYVQv"
            target="_blank"
            rel="noopener noreferrer"
          >
            View Kubernetes dashboard snapshot
          </a>
        </div>
      </div>

      <aside class="project-facts">
        <p class="eyebrow">Project Summary</p>

        <dl>
          <div>
            <dt>Role</dt>
            <dd>Platform designer and operator</dd>
          </div>

          <div>
            <dt>Distribution</dt>
            <dd>K3s</dd>
          </div>

          <div>
            <dt>Ingress</dt>
            <dd>Traefik</dd>
          </div>

          <div>
            <dt>Load balancing</dt>
            <dd>MetalLB</dd>
          </div>

          <div>
            <dt>Status</dt>
            <dd class="status-active">Active</dd>
          </div>
        </dl>
      </aside>
    </div>
  </section>

  <section class="technology-strip">
    <div class="container">
      <ul class="tag-list">
        {project.technologies.map((technology) => <li>{technology}</li>)}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container content-grid">
      <div class="section-heading">
        <p class="eyebrow">Executive Summary</p>
        <h2>Learning Kubernetes by operating a real platform.</h2>
      </div>

      <div class="prose">
        <p>
          The Kubernetes Homelab was created to develop practical experience
          beyond theory and temporary training clusters.
        </p>

        <p>
          The platform runs K3s on dedicated ARM64 hardware and includes
          containerd, MetalLB, Traefik, namespaces, deployments, services and
          ingress resources.
        </p>

        <p>
          The repository also includes architecture, deployment, operations,
          security, troubleshooting and decision documentation, demonstrating
          how the platform can be supported as well as deployed.
        </p>
      </div>
    </div>
  </section>

  <section class="section section-soft">
    <div class="container challenge-panel">
      <div>
        <p class="eyebrow">The Challenge</p>
        <h2>Translate container knowledge into orchestration capability.</h2>
      </div>

      <div>
        <p>
          Docker Compose provides effective container management on a single
          host, but it does not demonstrate Kubernetes scheduling, services,
          ingress, namespaces or cluster-oriented networking.
        </p>

        <p>
          The challenge was to create a manageable Kubernetes platform that
          provided real orchestration experience without introducing
          unnecessary complexity during the first implementation stage.
        </p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">Project Objectives</p>
        <h2>A platform designed for practical Kubernetes development.</h2>
      </div>

      <div class="objectives-grid">
        {
          objectives.map((objective, index) => (
            <article>
              <span>{String(index + 1).padStart(2, '0')}</span>
              <h3>{objective.title}</h3>
              <p>{objective.description}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section-soft">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">Delivery Approach</p>
        <h2>Building the platform in controlled stages.</h2>
      </div>

      <div class="delivery-timeline">
        {
          deliveryPhases.map((phase) => (
            <article>
              <span>{phase.number}</span>
              <div>
                <h3>{phase.title}</h3>
                <p>{phase.description}</p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">Core Components</p>
        <h2>Lightweight services providing standard Kubernetes capability.</h2>
      </div>

      <div class="components-grid">
        {
          components.map((component) => (
            <article>
              <p>{component.category}</p>
              <h3>{component.title}</h3>
              <span>{component.description}</span>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section-soft">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">Architecture</p>
        <h2>From LAN traffic to container workloads.</h2>
      </div>

      <div class="architecture-flow">
        <article>
          <span>01</span>
          <strong>Local Network</strong>
          <small>Clients access the assigned MetalLB address</small>
        </article>

        <div>↓</div>

        <article>
          <span>02</span>
          <strong>MetalLB</strong>
          <small>Provides a Kubernetes LoadBalancer address</small>
        </article>

        <div>↓</div>

        <article>
          <span>03</span>
          <strong>Traefik</strong>
          <small>Matches ingress rules and routes requests</small>
        </article>

        <div>↓</div>

        <article>
          <span>04</span>
          <strong>Kubernetes Service</strong>
          <small>Provides stable access to application pods</small>
        </article>

        <div>↓</div>

        <article>
          <span>05</span>
          <strong>Deployment and Pods</strong>
          <small>Run and maintain the required workload</small>
        </article>
      </div>
    </div>
  </section>

  <!-- ======================================================= -->
  <!-- PLATFORM ENVIRONMENT                                    -->
  <!-- ======================================================= -->

  <section class="section">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">Platform Environment</p>

        <h2>A dedicated Linux host for practical orchestration.</h2>

        <p>
          The cluster runs on dedicated ARM64 hardware with sufficient memory
          and NVMe storage to support the control plane, platform services and
          continued workload development.
        </p>
      </div>

      <div class="facts-grid">
        {
          platformFacts.map((fact) => (
            <article>
              <p>{fact.label}</p>
              <h3>{fact.value}</h3>
              <span>{fact.description}</span>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ======================================================= -->
  <!-- NAMESPACE DESIGN                                        -->
  <!-- ======================================================= -->

  <section class="section section-soft">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">Namespace Design</p>

        <h2>Separating applications from platform responsibilities.</h2>

        <p>
          Namespaces provide logical separation between application workloads,
          monitoring, logging, networking and future GitOps services.
        </p>
      </div>

      <div class="namespaces-grid">
        {
          namespaces.map((namespace) => (
            <article>
              <code>{namespace.name}</code>
              <p>{namespace.purpose}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ======================================================= -->
  <!-- FIRST WORKLOAD                                          -->
  <!-- ======================================================= -->

  <section class="section">
    <div class="container workload-panel">
      <div>
        <p class="eyebrow">First Application Deployment</p>

        <h2>{firstWorkload.title}</h2>

        <p>{firstWorkload.description}</p>

        <h3>Resources created</h3>

        <ul>
          {
            firstWorkload.resources.map((resource) => (
              <li>{resource}</li>
            ))
          }
        </ul>
      </div>

      <div class="workload-lessons">
        <p class="eyebrow">What It Demonstrated</p>

        {
          firstWorkload.lessons.map((lesson, index) => (
            <article>
              <span>{String(index + 1).padStart(2, '0')}</span>
              <p>{lesson}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">Architecture Decisions</p>
        <h2>Choices balancing realism and manageable complexity.</h2>
      </div>

      <div class="decisions-grid">
        {
          decisions.map((item) => (
            <article>
              <h3>{item.title}</h3>

              <h4>Decision</h4>
              <p>{item.decision}</p>

              <h4>Reason</h4>
              <p>{item.reason}</p>

              <h4>Benefit</h4>
              <p>{item.benefit}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section-soft">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">Project Delivery</p>
        <h2>Technical implementation supported by structured planning.</h2>
      </div>

      <div class="management-grid">
        {
          projectDelivery.map((item, index) => (
            <article>
              <span>{String(index + 1).padStart(2, '0')}</span>
              <h3>{item.title}</h3>
              <p>{item.description}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">Challenges</p>
        <h2>Resolving networking, sequencing and supportability issues.</h2>
      </div>

      <div class="challenges-grid">
        {
          challenges.map((challenge) => (
            <article>
              <h3>{challenge.title}</h3>

              <h4>Problem</h4>
              <p>{challenge.problem}</p>

              <h4>Response</h4>
              <p>{challenge.response}</p>

              <h4>Outcome</h4>
              <p>{challenge.outcome}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section-soft">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">Outcomes</p>
        <h2>A functioning base for continued Kubernetes development.</h2>
      </div>

      <div class="outcomes-grid">
        {
          outcomes.map((outcome) => (
            <article>
              <strong>{outcome.value}</strong>
              <h3>{outcome.title}</h3>
              <p>{outcome.description}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container skills-layout">
      <div class="section-heading">
        <p class="eyebrow">Skills Demonstrated</p>
        <h2>Container orchestration with operational documentation.</h2>
      </div>

      <div class="skills-list">
        {
          skills.map((skill, index) => (
            <article>
              <span>{String(index + 1).padStart(2, '0')}</span>
              <strong>{skill}</strong>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ======================================================= -->
  <!-- OPERATIONS                                              -->
  <!-- ======================================================= -->

  <section class="section">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">Operational Practices</p>

        <h2>Building a cluster that can be understood and supported.</h2>

        <p>
          The project is not considered complete when an application starts.
          Ongoing operation, troubleshooting and documentation are treated as
          part of the platform design.
        </p>
      </div>

      <div class="operations-grid">
        {
          operationalPractices.map((practice, index) => (
            <article>
              <span>{String(index + 1).padStart(2, '0')}</span>
              <h3>{practice.title}</h3>
              <p>{practice.description}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ======================================================= -->
  <!-- FUTURE ROADMAP                                          -->
  <!-- ======================================================= -->

  <section class="section section-soft">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">Platform Roadmap</p>

        <h2>Expanding capability in controlled stages.</h2>

        <p>
          The current cluster provides a stable learning foundation. Future
          improvements will be introduced only when they add clear operational
          or learning value.
        </p>
      </div>

      <div class="roadmap-grid">
        {
          futureRoadmap.map((item, index) => (
            <article>
              <span>{String(index + 1).padStart(2, '0')}</span>
              <h3>{item.title}</h3>
              <p>{item.description}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section-soft">
    <div class="container content-grid">
      <div class="section-heading">
        <p class="eyebrow">Lessons Learned</p>
        <h2>Cluster simplicity creates space to understand the fundamentals.</h2>
      </div>

      <div class="prose">
        <p>
          A smaller Kubernetes environment still provides meaningful
          experience with services, ingress, namespaces and orchestration.
        </p>

        <p>
          Address planning is essential when integrating MetalLB into an
          existing network.
        </p>

        <p>
          Kubernetes resources have dependencies, and applying them in a clear
          order makes failures easier to understand.
        </p>

        <p>
