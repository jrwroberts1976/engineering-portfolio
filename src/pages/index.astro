---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
---
<BaseLayout title="Infrastructure & Systems Engineer" description="James Roberts: infrastructure and systems engineer with 20+ years of experience, supported by practical evidence across Linux, Proxmox, Docker, automation, monitoring, networking and security.">
  <Hero />
  <section class="section section-soft">
    <div class="container">
      <div class="section-heading"><p class="eyebrow">Core Capabilities</p><h2>Skills backed by operational experience.</h2><p>The site is organised around what I can do, with projects and the engineering lab providing evidence.</p></div>
      <div class="cap-grid">
        <a href="/skills#linux"><strong>Linux &amp; Systems</strong><span>UNIX, Linux, administration, patching and troubleshooting</span></a>
        <a href="/skills#virtualisation"><strong>Virtualisation</strong><span>Proxmox VE, LXC, QEMU/KVM, clustering and recovery</span></a>
        <a href="/skills#containers"><strong>Containers</strong><span>Docker, Compose, Komodo and container lifecycle</span></a>
        <a href="/skills#automation"><strong>Automation</strong><span>Ansible, Bash, Git and repeatable infrastructure change</span></a>
        <a href="/skills#observability"><strong>Observability</strong><span>Prometheus, Grafana, Loki, Alloy and alerting</span></a>
        <a href="/skills#networking"><strong>Networking &amp; Security</strong><span>DNS, VPN, switching, firewalls, Greenbone, Suricata and Zeek</span></a>
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container evidence">
      <div><p class="eyebrow">Engineering Experience</p><h2>Explore my engineering work.</h2><p>Project case studies cover design decisions, implementation, operations, troubleshooting, automation and recovery across the technologies I work with.</p></div>
      <div class="button-row"><a class="button button-primary" href="/projects">Projects</a><a class="button button-secondary" href="/lab">Current engineering work</a></div>
    </div>
  </section>
</BaseLayout>
<style>
.cap-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem}
.cap-grid a{display:grid;align-content:start;gap:.45rem;padding:1.5rem;border:1px solid var(--border);border-radius:var(--radius);background:var(--surface);text-decoration:none;transition:transform 160ms ease,border-color 160ms ease,background 160ms ease}
.cap-grid a:hover,.cap-grid a:focus-visible{transform:translateY(-3px);border-color:rgba(93,184,255,.45);background:var(--surface-hover)}
.cap-grid strong{color:var(--primary);font-size:1.2rem}.cap-grid span,.evidence p{color:var(--text-muted)}
.evidence{display:grid;grid-template-columns:1fr auto;gap:4rem;align-items:center}.evidence h2{margin:.2rem 0;font-size:clamp(1.9rem,4vw,3.5rem)}
@media(max-width:900px){.cap-grid{grid-template-columns:repeat(2,1fr)}.evidence{grid-template-columns:1fr;gap:2rem}}
@media(max-width:600px){.cap-grid{grid-template-columns:1fr}}
@media(prefers-reduced-motion:reduce){.cap-grid a:hover{transform:none}}
</style>
