---
/*
|--------------------------------------------------------------------------
| Featured Projects
|--------------------------------------------------------------------------
|
| Project information is loaded from:
|
|   src/data/projects.ts
|
| To change which projects appear here, edit the featured property
| in the central project data.
|
*/

import { featuredProjects } from '../data/projects';
---

<section class="section section-soft">
  <div class="container">
    <div class="section-heading">
      <p class="eyebrow">Featured Engineering Projects</p>

      <h2>Real engineering projects.</h2>

      <p>
        Practical infrastructure projects demonstrating platform engineering,
        observability, cloud technologies, automation and operational
        resilience.
      </p>
    </div>

    <div class="grid card-grid">
      {
        featuredProjects.map((project) => (
          <article class="card project-card">
            <p class="eyebrow">{project.category}</p>

            <h3>{project.shortTitle}</h3>

            <p>{project.description}</p>

            <ul
              class="tag-list"
              aria-label={`${project.title} technologies`}
            >
              {
                project.technologies.slice(0, 4).map((technology) => (
                  <li>{technology}</li>
                ))
              }
            </ul>

            <a class="card-link" href={project.href}>
              View project →
            </a>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .project-card {
    display: flex;
    min-height: 340px;
    flex-direction: column;
  }

  .project-card .tag-list {
    margin-bottom: 1.4rem;
  }

  .project-card .card-link {
    margin-top: auto;
  }
</style>
