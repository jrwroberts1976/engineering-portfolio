---
/*
|--------------------------------------------------------------------------
| Architecture Node
|--------------------------------------------------------------------------
|
| Displays one component of the engineering platform.
|
| Project and dashboard links are resolved from central data.
|
*/

import type { PlatformNode } from '../data/types';

import { getProjectById } from '../data/projects';
import { getDashboardById } from '../data/dashboards';

interface Props {
  node: PlatformNode;
}

const { node } = Astro.props;

const project = node.projectId
  ? getProjectById(node.projectId)
  : undefined;

const dashboard = node.dashboardId
  ? getDashboardById(node.dashboardId)
  : undefined;

const dashboardAvailable = Boolean(dashboard?.url);
---

<article class={`architecture-node node-${node.id}`}>
  <div class="node-header">
    <div>
      <p class="node-category">{node.category}</p>
      <h3>{node.title}</h3>
    </div>

    <span class="node-status">
      <span class="status-dot"></span>
      {node.status}
    </span>
  </div>

  <p class="node-description">{node.description}</p>

  <div class="node-links">
    {
      project && (
        <a href={project.href}>
          View project →
        </a>
      )
    }

    {
      dashboardAvailable && (
        <a
          href={dashboard?.url}
          target="_blank"
          rel="noopener noreferrer"
        >
          Live dashboard ↗
        </a>
      )
    }
  </div>
</article>

<style>
  .architecture-node {
    display: flex;
    min-height: 230px;
    flex-direction: column;
    padding: 1.35rem;
    border: 1px solid var(--border);
    border-radius: 15px;
    background:
      radial-gradient(
        circle at top right,
        rgba(93, 184, 255, 0.11),
        transparent 11rem
      ),
      var(--surface);
    transition:
      transform 160ms ease,
      border-color 160ms ease,
      background 160ms ease;
  }

  .architecture-node:hover {
    transform: translateY(-4px);
    border-color: rgba(93, 184, 255, 0.48);
    background:
      radial-gradient(
        circle at top right,
        rgba(93, 184, 255, 0.17),
        transparent 13rem
      ),
      var(--surface-hover);
  }

  .node-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
  }

  .node-category {
    margin: 0 0 0.3rem;
    color: var(--primary);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  h3 {
    margin: 0;
    font-size: 1.25rem;
  }

  .node-status {
    display: inline-flex;
    align-items: center;
    gap: 0.38rem;
    white-space: nowrap;
    color: #8ff0bc;
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .status-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: currentColor;
    box-shadow: 0 0 9px currentColor;
  }

  .node-description {
    color: var(--text-muted);
    font-size: 0.94rem;
  }

  .node-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-top: auto;
    padding-top: 1rem;
  }

  .node-links a {
    color: var(--primary);
    font-size: 0.88rem;
    font-weight: 750;
    text-decoration: none;
  }
</style>
