---
/*
|--------------------------------------------------------------------------
| Live Grafana Dashboards + Historical BirdNET Telemetry
|--------------------------------------------------------------------------
*/

import DashboardCard from './DashboardCard.astro';
import BirdActivityHeatmap from './BirdActivityHeatmap.astro';

import { dashboards } from '../data/dashboards';
import { getProjectById } from '../data/projects';

const liveDashboards = dashboards.filter((dashboard) => dashboard.id !== 'birdnet');
---

<section id="live-dashboards" class="section">
  <div class="container">
    <div class="section-heading">
      <p class="eyebrow">Engineering Telemetry</p>

      <h2>Real platforms. Real operational data.</h2>

      <p>
        Read-only Grafana dashboards provide live operational evidence from my
        engineering platform. The BirdNET panel currently presents a historical
        detection sample while that specialist workload is offline.
      </p>
    </div>

    <div class="dashboard-grid">
      {
        liveDashboards.map((dashboard) => {
          const project = getProjectById(dashboard.projectId);

          return (
            <DashboardCard
              category={dashboard.category}
              title={dashboard.title}
              description={dashboard.description}
              status={dashboard.status}
              dashboardUrl={dashboard.url}
              projectUrl={project?.href}
            />
          );
        })
      }

      <BirdActivityHeatmap />
    </div>
  </div>
</section>

<style>
  .dashboard-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
  }

  @media (max-width: 950px) {
    .dashboard-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
