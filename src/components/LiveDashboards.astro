---
/*
|--------------------------------------------------------------------------
| Public Grafana Dashboards
|--------------------------------------------------------------------------
*/

import DashboardCard from './DashboardCard.astro';

import { dashboards } from '../data/dashboards';
import { getProjectById } from '../data/projects';
---

<section id="live-dashboards" class="section">
  <div class="container">
    <div class="section-heading">
      <p class="eyebrow">Engineering Telemetry</p>

      <h2>Real platforms. Real operational data.</h2>

      <p>
        Read-only Grafana dashboards provide operational evidence from my
        engineering platform, including infrastructure monitoring, security
        telemetry and BirdNET wildlife detection data.
      </p>
    </div>

    <div class="dashboard-grid">
      {
        dashboards.map((dashboard) => {
          const project = getProjectById(dashboard.projectId);

          return (
            <DashboardCard
              category={dashboard.category}
              title={dashboard.title}
              description={dashboard.description}
              status={dashboard.status}
              dashboardUrl={dashboard.url}
              projectUrl={project?.href}
            />
          );
        })
      }
    </div>
  </div>
</section>

<style>
  .dashboard-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem;
  }

  @media (max-width: 950px) {
    .dashboard-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
