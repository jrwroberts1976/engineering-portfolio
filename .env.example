PORTFOLIO_PORT=8095

PUBLIC_GRAFANA_SECURITY_DASHBOARD=https://grafana.example.com/public-dashboards/security-id
PUBLIC_GRAFANA_PLATFORM_DASHBOARD=https://grafana.example.com/public-dashboards/platform-id
PUBLIC_GRAFANA_BIRDNET_DASHBOARD=https://grafana.example.com/public-dashboards/birdnet-id

# Public Cloudflare Turnstile site key. Safe to compile into the website.
PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key

# Private contact API values. Keep real values outside Git.
TURNSTILE_SECRET_KEY=your-turnstile-secret-key
TURNSTILE_EXPECTED_HOSTNAME=me.jrwroberts.co.uk

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-gmail-address@example.com
SMTP_PASSWORD=your-app-password
CONTACT_TO_EMAIL=your-destination-address@example.com
CONTACT_FROM_EMAIL=your-gmail-address@example.com

CONTACT_RATE_LIMIT_COUNT=5
CONTACT_RATE_LIMIT_WINDOW_SECONDS=3600
CONTACT_MAX_BODY_BYTES=16384
